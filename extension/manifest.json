{
  "manifest_version": 3,
  "name": "Page to PDF — Full Page Screenshot",
  "description": "__MSG_appDesc__",
  "default_locale": "en",
  "version": "1.0.11",
  "homepage_url": "https://page-to-pdf-screenshot.vercel.app/",
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["debugger", "activeTab", "alarms"],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+Y",
        "mac": "Alt+Shift+Y"
      },
      "description": "__MSG_commandDesc__"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

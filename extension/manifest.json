{
  "manifest_version": 3,
  "name": "Copy to AI — Full Page Screenshot",
  "description": "Знімає всю сторінку вниз і зберігає PNG або PDF, щоб закинути файл в AI.",
  "version": "1.0.0",
  "action": {
    "default_title": "Зняти всю сторінку для AI",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["debugger", "activeTab"],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+Y",
        "mac": "Alt+Shift+Y"
      },
      "description": "Зняти всю сторінку для AI"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
